-- this beyond the chunk bounds. 0 = always present (silhouettes, landmarks).
Config.Lod = {
	Props = 650,
	Detail = 1400,
	District = 4200,
}

local function rgb(r: number, g: number, b: number): { number }
	return { r, g, b }
end
