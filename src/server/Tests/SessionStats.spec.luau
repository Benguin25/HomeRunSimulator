--!strict
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Stats = require(Shared.Gameplay.SessionStats)
local Rules = require(Shared.Gameplay.RecordRules)
local Replica = require(Shared.Gameplay.SessionReplica)
local Net = require(Shared.Gameplay.GameplayNet)
local Landing = require(Shared.BattedBall.LandingDetector)
local Test = require(script.Parent.TestUtil)

local function outcome(
	feet: number,
	kind: Landing.OutcomeKind?,
	territory: ("Fair" | "Foul")?,
	provisional: boolean?
): Landing.OutcomePayload
	return {
		kind = kind or "Landed",
		territory = territory or "Fair",
		territoryProvisional = provisional or false,
		endTime = 4,
		sprayAngleDegrees = 0,
		carryMeters = feet * 0.3048,
		projectedCarryMeters = 9999,
		impactDistanceMeters = 8888,
	}
end
local function hit(s: Stats.State, id: number, feet: number, result: Landing.OutcomePayload?)
	Stats.pitch(s, "Lane1", id)
	Stats.swing(s, id, true, true)
	Stats.contact(s, id, 100)
	Stats.resolve(s, id, result or outcome(feet))
end

return function(t)
	t.test("accepted pitch, swing, contact, practice and miss events count once", function()
		local s = Stats.new()
		Test.assertTrue(Stats.pitch(s, "Lane1", 1), "first pitch")
		Test.assertTrue(not Stats.pitch(s, "Lane1", 1), "duplicate pitch")
		Stats.swing(s, 1, false, false) -- accepted practice swing
		Stats.swing(s, 2, true, false) -- actual miss
		Test.assertTrue(not Stats.swing(s, 2, true, false), "duplicate swing")
		Stats.swing(s, 3, true, true)
		Stats.contact(s, 8, 101)
		Test.assertTrue(not Stats.contact(s, 8, 110), "duplicate contact")
		local v = Stats.snapshot(s)
		Test.assertEqual(v.pitches, 1)
		Test.assertEqual(v.swings, 3)
		Test.assertEqual(v.contacts, 1)
		Test.assertEqual(v.misses, 1)
		Test.assertNear(v.contactPercent, 100 / 3, 1e-6)
		Test.assertEqual(v.highestExitMph, 101)
	end)
	t.test("averages use measured fair carries only and records celebrate improvements", function()
		local s = Stats.new()
		hit(s, 1, 200)
		local first = Stats.snapshot(s)
		assert(first.award, "first record")
		Test.assertTrue(first.award.baseline, "baseline record")
		Test.assertEqual(first.over200, 0, "over is strict; milestone is inclusive")
		Test.assertEqual(first.award.milestonesFeet[1], 200)
		hit(s, 2, 202)
		local small = Stats.snapshot(s)
		assert(small.award, "small record")
		Test.assertTrue(not small.award.baseline, "breaks an existing record")
		Test.assertNear(small.averageDistanceMeters / 0.3048, 201, 1e-6)
		Test.assertEqual(#small.award.milestonesFeet, 0, "milestone once")
		hit(s, 3, 302)
		local big = Stats.snapshot(s)
		assert(big.award, "large record")
		Test.assertTrue(big.award.intensity > small.award.intensity + 0.5, "improvement scales celebration")
		Test.assertEqual(big.fairHits, 3)
		Test.assertEqual(big.measuredFairHits, 3)
		Test.assertNear(big.totalDistanceMeters / 0.3048, 704, 1e-6)
		Test.assertNear(big.averageDistanceMeters / 0.3048, 704 / 3, 1e-6)
		Test.assertNear(big.longestMeters / 0.3048, 302, 1e-6)
		Test.assertEqual(big.over300, 1)
		Test.assertEqual(big.nextMilestoneFeet, 350)
	end)
	t.test("ties, smaller hits and duplicate results do not award another record", function()
		local s = Stats.new()
		hit(s, 1, 300)
		local version = s.value.version
		Test.assertTrue(not Stats.resolve(s, 1, outcome(900)), "duplicate result")
		Test.assertEqual(s.value.version, version, "no duplicate snapshot increment")
		hit(s, 2, 300)
		Test.assertTrue(s.value.award == nil, "exact tie")
		hit(s, 3, 300 + 0.005 / 0.3048)
		Test.assertTrue(s.value.award == nil, "tie tolerance")
		hit(s, 4, 150)
		Test.assertTrue(s.value.award == nil, "shorter hit")
		Test.assertNear(s.value.longestMeters / 0.3048, 300, 1e-6)
	end)
	t.test("fouls, walls, provisional landings and no-impact paths cannot set distance records", function()
		local s = Stats.new()
		hit(s, 1, 450, outcome(450, "Landed", "Foul"))
		hit(s, 2, 800, outcome(800, "Obstacle"))
		hit(s, 3, 900, outcome(900, "NoImpact"))
		hit(s, 4, 800, outcome(800, "Landed", "Fair", true))
		Test.assertEqual(s.value.contacts, 4)
		Test.assertEqual(s.value.fairHits, 2, "wall and provisional fair first impacts")
		Test.assertEqual(s.value.measuredFairHits, 0)
		Test.assertEqual(s.value.longestMeters, 0)
		Test.assertEqual(s.value.totalDistanceMeters, 0)
		Test.assertEqual(s.value.averageDistanceMeters, 0)
		Test.assertTrue(s.value.award == nil, "no record from projected or impact distance")
		for _, distance in { 0 / 0, math.huge, -1 } do
			local invalid = outcome(distance)
			Test.assertTrue(not Rules.eligible(invalid), "invalid distance")
		end
	end)
	t.test("unresolved and canceled contacts keep their EV but never award carry", function()
		local s = Stats.new()
		Stats.swing(s, 1, true, true)
		Stats.contact(s, 1, 108)
		Test.assertEqual(s.value.longestMeters, 0, "launch isn't a distance result")
		Test.assertTrue(Stats.cancel(s, 1), "cancel once")
		Test.assertTrue(not Stats.cancel(s, 1), "duplicate cancel")
		Test.assertTrue(not Stats.resolve(s, 1, outcome(500)), "late result after cancel")
		Test.assertTrue(not Stats.resolve(s, 99, outcome(500)), "unregistered result")
		Test.assertEqual(s.value.contacts, 1)
		Test.assertEqual(s.value.highestExitMph, 108)
		Test.assertEqual(s.value.measuredFairHits, 0)
		Test.assertTrue(next(s.pending) == nil, "terminal IDs do not accumulate")
	end)
	t.test("milestones are inclusive, once per session and completion is bounded", function()
		local s = Stats.new()
		hit(s, 1, 500)
		assert(s.value.award, "award")
		Test.assertEqual(#s.value.award.milestonesFeet, 7)
		Test.assertTrue(s.value.nextMilestoneFeet == nil, "all complete")
		Test.assertEqual(s.value.milestoneProgress, 1)
		Test.assertEqual(s.value.over200, 1)
		Test.assertEqual(s.value.over300, 1)
		Test.assertEqual(s.value.over400, 1)
		hit(s, 2, 510)
		assert(s.value.award, "new record")
		Test.assertEqual(#s.value.award.milestonesFeet, 0, "do not repeat milestones")
	end)
	t.test("players, lanes and session cleanup stay isolated", function()
		local a, b = Stats.new(), Stats.new()
		hit(a, 1, 400)
		hit(b, 2, 250)
		Stats.pitch(a, "Lane2", 1) -- lane-local pitch IDs
		Test.assertEqual(a.value.pitches, 2)
		Test.assertNear(a.value.longestMeters / 0.3048, 400, 1e-6)
		Test.assertNear(b.value.longestMeters / 0.3048, 250, 1e-6)
		local resetCharacter = Stats.snapshot(a) -- respawn leaves session reducer intact
		Test.assertEqual(resetCharacter.contacts, 1)
		local copy = Stats.snapshot(a)
		assert(copy.award, "record snapshot")
		copy.award.milestonesFeet[1] = -1
		assert(a.value.award, "server record")
		Test.assertEqual(a.value.award.milestonesFeet[1], 200, "snapshot is detached")
		local rejoined = Stats.new() -- PlayerRemoving drops state; joining creates new state
		Test.assertEqual(rejoined.value.contacts, 0)
		Test.assertEqual(rejoined.value.longestMeters, 0)
	end)
	t.test("late snapshots and duplicate notices cannot overwrite or re-celebrate", function()
		local s = Stats.new()
		hit(s, 1, 250)
		local replica = Replica.new()
		local fresh: Net.Snapshot = { version = 8, stats = Stats.snapshot(s) }
		Test.assertTrue(Replica.apply(replica, fresh), "latest event")
		Test.assertEqual(Replica.celebration(replica), 1)
		Test.assertTrue(not Replica.apply(replica, { version = 7, stats = Stats.snapshot(Stats.new()) }), "late init")
		Test.assertTrue(not Replica.apply(replica, fresh), "duplicate message")
		Test.assertTrue(Replica.celebration(replica) == nil, "award once")
		Test.assertTrue(Replica.apply(replica, { version = 9, stats = Stats.snapshot(s) }), "loop-only update")
		Test.assertTrue(Replica.celebration(replica) == nil, "same award in a newer envelope")
		assert(replica.value, "replica value")
		Test.assertEqual(replica.value.stats.contacts, 1)
	end)
end
