--!strict
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Toggle = require(Shared.Presentation.DebugToggle)
local Config = require(Shared.Pitching.PitchConfig)
local GameplayConfig = require(Shared.Gameplay.GameplayConfig)
local Test = require(script.Parent.TestUtil)

return function(t)
	t.test("development debug is hidden initially and published opt-in is explicit", function()
		Test.assertTrue(not Config.Debug.EnableInPublished, "published debugging must default off")
		Test.assertTrue(Toggle.allowed(true, true, false), "Studio available")
		Test.assertTrue(not Toggle.allowed(false, true, false), "published disabled")
		Test.assertTrue(Toggle.allowed(false, true, true), "explicit development opt-in")
		Test.assertTrue(not Toggle.allowed(true, false, true), "master disable in Studio")
		Test.assertTrue(not Toggle.allowed(false, false, true), "master disable in published")
		for _, enabled in { true, false } do
			Test.assertTrue(not Toggle.new(enabled).visible, "all sessions start hidden")
		end
	end)
	t.test("processed-input fallback and action callbacks toggle exactly once per press", function()
		local state = Toggle.new(true)
		Test.assertTrue(Toggle.input(state, true, false), "first Begin shows debug")
		Test.assertTrue(state.visible)
		Test.assertTrue(not Toggle.input(state, true, false), "second input route")
		Test.assertTrue(not Toggle.input(state, true, false), "key repeat")
		Test.assertTrue(state.visible, "duplicate Begin cannot immediately hide")
		Test.assertTrue(not Toggle.input(state, false, false), "End doesn't toggle")
		Test.assertTrue(not Toggle.input(state, false, false), "duplicate End")
		Test.assertTrue(Toggle.input(state, true, false), "next press hides")
		Test.assertTrue(not state.visible)
	end)
	t.test("typing, focus loss and disabled debug cannot strand the key latch", function()
		local state = Toggle.new(true)
		Test.assertTrue(not Toggle.input(state, true, true), "typing does not toggle")
		Test.assertTrue(not state.visible)
		Test.assertTrue(not Toggle.input(state, true, false), "holding while leaving a textbox isn't a new press")
		Toggle.release(state)
		Test.assertTrue(Toggle.input(state, true, false), "focus-lost recovery")
		Toggle.release(state)
		Test.assertTrue(state.visible, "losing focus doesn't change visibility")
		Test.assertTrue(Toggle.input(state, true, false), "next focused press hides")
		local disabled = Toggle.new(false)
		Test.assertTrue(not Toggle.input(disabled, true, false), "disabled input")
		Test.assertTrue(not disabled.visible)
	end)
	t.test("one toggle stays independent of batting, flight and gameplay snapshot updates", function()
		local state = Toggle.new(true)
		for _, phase in { "Batting", "ContactTransition", "BallFollow", "Landing", "Returning", "Batting" } do
			Toggle.release(state)
			Test.assertTrue(Toggle.input(state, true, false), `{phase}: show`)
			Test.assertTrue(state.visible, `{phase}: shared sections stay visible`)
			Toggle.release(state)
			Test.assertTrue(Toggle.input(state, true, false), `{phase}: hide`)
			Test.assertTrue(not state.visible, `{phase}: shared sections stay hidden`)
		end
		Test.assertEqual(Config.Debug.ToggleKey, "F7", "dedicated diagnostic key")
		Test.assertTrue(Config.Debug.ToggleKey ~= GameplayConfig.Hud.StatsKey, "stats control separate")
		Test.assertTrue(Config.Debug.ToggleKey ~= GameplayConfig.Hud.SkipKey, "skip control separate")
	end)
end
