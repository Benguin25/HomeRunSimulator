--!strict
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local View = require(Shared.Presentation.OpeningView)
local Test = require(script.Parent.TestUtil)
return function(t: any)
	t.test("distant home-plate backdrop is covered beyond the nearby streaming radius", function()
		local plate = CFrame.lookAt(Vector3.zero, Vector3.new(0, 0, -1))
		Test.assertTrue(View.includes(plate, CFrame.new(0, 100, -6000), Vector3.one * 100, 1600, 80))
		Test.assertTrue(not View.includes(plate, CFrame.new(0, 100, 6000), Vector3.one * 100, 1600, 80))
		Test.assertTrue(View.includes(plate, CFrame.new(0, 0, 500), Vector3.one, 1600, 80))
	end)
	t.test("view coverage follows rotated stadiums and includes bounds crossing its edge", function()
		local plate = CFrame.lookAt(Vector3.new(400, 0, 700), Vector3.new(401, 0, 700))
		Test.assertTrue(View.includes(plate, CFrame.new(6400, 100, 700), Vector3.one * 100, 1600, 80))
		Test.assertTrue(not View.includes(plate, CFrame.new(-5600, 100, 700), Vector3.one * 100, 1600, 80))
		local edge = CFrame.new(Vector3.new(0, 0, -5000) + Vector3.new(1000, 0, 0))
		Test.assertTrue(View.includes(CFrame.identity, edge, Vector3.one * 1800, 100, 5))
	end)
end
